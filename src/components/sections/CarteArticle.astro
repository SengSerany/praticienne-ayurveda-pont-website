---
import NumeroChapitre from '../ui/NumeroChapitre.astro';

interface Props {
  titre: string;
  href: string;
  chapitre: number;
  themeLabel: string;
  minutes: number;
  brouillon?: boolean;
}
const { titre, href, chapitre, themeLabel, minutes, brouillon = false } = Astro.props;
---

<a class="carte-article carte-lien" href={href}>
  <p class="carte-article__meta">
    <NumeroChapitre n={chapitre} /> - {themeLabel} - {minutes} min de lecture
  </p>
  <h3>{titre}</h3>
  {brouillon && <span class="carte-article__brouillon">Brouillon - a valider</span>}
</a>

<style>
  /* En colonne : la mention de brouillon tombe au pied de la carte, a la meme
     hauteur d'une carte a l'autre, quelle que soit la longueur du titre. */
  .carte-article {
    display: flex;
    flex-direction: column;
    background-color: var(--c-papier);
    border: 1px solid var(--c-creme);
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    text-decoration: none;
    color: var(--c-encre);
  }
  .carte-article__meta {
    font-family: var(--f-mono);
    font-size: var(--t-label-size);
    letter-spacing: var(--t-label-ls);
    text-transform: uppercase;
    color: var(--c-label);
    margin: 0 0 1rem;
  }
  .carte-article h3 {
    margin: 0;
  }
  .carte-article__brouillon {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 2rem;
    font-family: var(--f-mono);
    font-size: var(--t-label-size);
    letter-spacing: var(--t-label-ls);
    text-transform: uppercase;
    color: var(--c-terre);
  }
</style>
