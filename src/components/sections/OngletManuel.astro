---
import Illustration from '../ui/Illustration.astro';

interface Props {
  titre: string;
  // Sans resume ni illustration, l'onglet devient un bouton : le titre seul.
  resume?: string;
  href: string;
  star?: boolean;
  aVenir?: boolean;
  illustrationRef?: string;
  // Fil de lecture que l'onglet selectionne, lu par le filtre des chapitres.
  porte?: string;
}
const { titre, resume, href, star = false, aVenir = false, illustrationRef, porte } = Astro.props;
const Tag = aVenir ? 'div' : 'a';
const titreSeul = !resume && !illustrationRef;
---

<Tag
  class:list={[
    'onglet',
    {
      'onglet--star': star,
      'onglet--a-venir': aVenir,
      'onglet--titre-seul': titreSeul,
      'carte-lien': !aVenir,
    },
  ]}
  href={aVenir ? undefined : href}
  data-porte={porte}
>
  <span class="onglet__languette"></span>
  {
    illustrationRef && (
      <Illustration ref={illustrationRef} alt={`Illustration ${titre}`} decoratif />
    )
  }
  <h4>{titre}</h4>
  {resume && <p>{resume}</p>}
  {aVenir && <span class="onglet__badge">À venir</span>}
</Tag>

<style>
  .onglet {
    display: block;
    position: relative;
    background-color: var(--c-papier);
    border: 1px solid var(--c-creme);
    padding: 1.5rem;
    text-decoration: none;
    color: var(--c-encre);
  }
  .onglet__languette {
    position: absolute;
    top: -1px;
    left: 1.5rem;
    width: 2.5rem;
    height: 4px;
    background-color: var(--c-sauge);
  }
  .onglet--star .onglet__languette {
    background-color: var(--c-dore);
  }
  .onglet--a-venir {
    opacity: 0.7;
  }
  /* Onglet-bouton : le titre seul dans une carte resserree. Le fil choisi garde
     l'aspect du survol, pour qu'on sache ou l'on lit. */
  .onglet--titre-seul {
    display: flex;
    align-items: center;
    min-height: 4.5rem;
    padding: 1rem 1.5rem;
  }
  .onglet--titre-seul h4 {
    margin: 0;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.3125rem);
  }
  .onglet[aria-current='true'] {
    border-color: var(--carte-contour);
    box-shadow: inset 0 0 0 1px var(--carte-contour);
  }
  .onglet p {
    margin-bottom: 0;
    font-size: var(--t-small-size);
    color: var(--c-muted);
  }
  .onglet__badge {
    display: inline-block;
    margin-top: 0.75rem;
    font-family: var(--f-mono);
    font-size: var(--t-label-size);
    letter-spacing: var(--t-label-ls);
    text-transform: uppercase;
    color: var(--c-brun-reliure);
  }
</style>
