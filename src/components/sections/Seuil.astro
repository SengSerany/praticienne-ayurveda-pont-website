---
import Button from '../ui/Button.astro';
import ClauseYmyl from '../ui/ClauseYmyl.astro';
import Motif from '../ui/Motif.astro';
import { ctaPrincipal } from '../../data/site';
import { svgEnLigne } from '../../lib/svg';

interface Props {
  titre: string;
  repli?: string;
}
const { titre, repli } = Astro.props;
const planche = svgEnLigne('/planche-seuil.svg');
---

<section class="seuil">
  {planche && <div class="seuil__planche" set:html={planche} />}
  <Motif />
  <h2>{titre}</h2>
  <div class="seuil__corps"><slot /></div>
  <Button href={ctaPrincipal.href} label={ctaPrincipal.label} variant="filled" />
  {repli && <p class="seuil__repli">{repli}</p>}
  <ClauseYmyl />
</section>

<style>
  .seuil {
    position: relative;
    isolation: isolate;
    background-color: var(--c-terre);
    color: var(--c-papier);
    padding: var(--espace-section) var(--marge-page);
  }
  /* Planche d'herbier sous le texte, dans la moitie laissee vide. Sa boite
     commence un peu avant la fin de la colonne de texte : le dessin, ancre en
     bas a droite, retrecit avec le bloc au lieu de glisser sous le texte. En
     mobile le texte prend toute la largeur, la planche s'efface. */
  .seuil__planche {
    position: absolute;
    inset-block: 0;
    inset-inline: calc(var(--marge-page) + 30rem) 0;
    z-index: -1;
    color: var(--c-couverture);
    opacity: 0.5;
    pointer-events: none;
  }
  .seuil__planche :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 48rem) {
    .seuil__planche {
      display: none;
    }
  }
  .seuil h2 {
    color: var(--c-papier);
    max-width: 28rem;
    margin-bottom: 0.8em;
  }
  .seuil__corps {
    max-width: 34rem;
    margin-bottom: calc(var(--rythme-para) * 2);
  }
  .seuil__corps:empty {
    display: none;
  }
  .seuil__repli {
    font-size: var(--t-small-size);
    color: var(--c-papier);
  }
  .seuil :global(a) {
    color: var(--c-papier);
  }
  .seuil :global(.button--filled) {
    background-color: var(--c-papier);
    color: var(--c-encre);
  }
  .seuil :global(.button--filled:hover) {
    background-color: var(--c-couverture);
  }
  .seuil :global(.clause-ymyl) {
    color: var(--c-papier);
    margin-top: 2.25rem;
  }
  /* Le motif suit le rythme du fond qui le porte, pas le sien : ici un aplat
     colore, donc le palier des blocs contenus. */
  .seuil :global(.motif) {
    color: var(--c-couverture);
    margin-top: 0;
    margin-bottom: var(--espace-section);
  }
</style>
