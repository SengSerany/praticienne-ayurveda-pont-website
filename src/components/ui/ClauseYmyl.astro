---
interface Props {
  sujet?: string;
}
const { sujet = 'Cet accompagnement' } = Astro.props;
const clause = `${sujet} est complémentaire d'un suivi médical et ne s'y substitue pas.`;
---

<p class="clause-ymyl">{clause}</p>

<style>
  .clause-ymyl {
    font-family: var(--f-mono);
    font-size: var(--t-caption-size);
    line-height: var(--t-caption-lh);
    letter-spacing: var(--t-caption-ls);
    color: var(--c-muted);
    max-width: 32rem;
    margin: 0;
  }
</style>
