---
// Les schemas sont integres en ligne et non en <img> : un SVG servi comme image
// ne peut pas charger la police du site, ses etiquettes retomberaient sur la
// mono systeme. Chaque fichier porte son propre title et desc.
import { svgEnLigne } from '../../lib/svg';

interface Props {
  ref: string;
  alt: string;
  src?: string;
  legende?: string;
}
const { ref, alt, src, legende } = Astro.props;

const svg = src ? svgEnLigne(src) : undefined;
---

<figure class="schema">
  {
    svg ? (
      <Fragment set:html={svg} />
    ) : src ? (
      <img src={src} alt={alt} />
    ) : (
      <div class="schema-placeholder" role="img" aria-label={alt}>
        <span class="schema-placeholder__ref">{ref}</span>
      </div>
    )
  }
  {legende && <figcaption>{legende}</figcaption>}
</figure>

<style>
  /* Chaque schema s'affiche a la taille nominale de son fichier, jamais
     au-dela, et retrecit si sa colonne est plus etroite : sa densite decide de
     sa taille, pas la colonne qui le porte. La legende se cale sur la largeur
     du dessin sans jamais l'elargir. */
  .schema {
    margin: 0;
    inline-size: fit-content;
    max-inline-size: 100%;
  }
  /* Le SVG arrive par set:html, donc hors du scope Astro, et il echappe a la
     regle img de base.css. Sans ca il deborde sur mobile. */
  .schema :global(svg) {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .schema-placeholder {
    inline-size: 34rem;
    max-inline-size: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 8rem;
    padding: 1.5rem;
    background-color: var(--c-papier-chaleur);
    border: 1px dashed var(--c-brun-reliure);
  }
  .schema-placeholder__ref {
    font-family: var(--f-mono);
    font-size: var(--t-label-size);
    letter-spacing: var(--t-label-ls);
    text-transform: uppercase;
    color: var(--c-brun-reliure);
  }
  .schema figcaption {
    contain: inline-size;
    font-family: var(--f-mono);
    font-size: var(--t-caption-size);
    color: var(--c-muted);
    margin-top: 1.25rem;
  }
</style>
