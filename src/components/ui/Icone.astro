---
// Jeu d'icones du site : trait seul sur une grille de 24, epaisseur 1,2 tenue a
// toutes les tailles, bouts et jonctions ronds. Elles prolongent le trait des
// planches botaniques, elles n'introduisent pas une troisieme main.
interface Props {
  nom: 'fiole' | 'bol' | 'pont' | 'horloge' | 'signet' | 'boussole';
}
const { nom } = Astro.props;

const traces: Record<Props['nom'], string> = {
  // Fiole de laboratoire : le verre epais du CNRGS, pas la gelule.
  fiole:
    '<path d="M9.5 3.5h5M10.5 3.5v4.5M13.5 3.5v4.5"/><path d="M9 8h6v10.5a2.5 2.5 0 0 1-2.5 2.5h-1a2.5 2.5 0 0 1-2.5-2.5z"/><path d="M9 15.5h6"/>',
  // Bol : la nourriture qui rechauffe, jamais la portion que l'on compte.
  bol: '<path d="M3.5 10.5h17"/><path d="M5 10.5a7 7 0 0 0 14 0"/><path d="M9.5 4.5v2.5M14.5 4.5v2.5"/>',
  // Pont : le concept meme du site, deux rives que rien n'oppose.
  pont: '<path d="M3 10h18"/><path d="M5.5 10v9.5M18.5 10v9.5"/><path d="M7.5 19.5a4.5 4.5 0 0 1 9 0"/><path d="M3 19.5h18"/>',
  // Horloge : le temps pose de l'echange, une demi-heure.
  horloge: '<circle cx="12" cy="12" r="8.5"/><path d="M12 6.5V12l4 2.5"/>',
  // Signet : on peut refermer le manuel et y revenir, rien ne retient.
  signet: '<path d="M7.5 3.5h9v17l-4.5-4-4.5 4z"/>',
  // Boussole : etre orientee, y compris vers quelqu'un d'autre.
  boussole:
    '<circle cx="12" cy="12" r="8.5"/><path d="M8.8 15.2l6.4-6.4"/><path d="M15.2 8.8l-3 .6M15.2 8.8l-.6 3"/>',
};
---

<svg
  class="icone"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  vector-effect="non-scaling-stroke"
  aria-hidden="true"
  set:html={traces[nom]}
/>

<style>
  .icone {
    display: block;
    width: 1.75rem;
    height: auto;
    margin-block-end: 1rem;
    color: var(--c-brun-reliure);
  }
  .icone :global(*) {
    vector-effect: non-scaling-stroke;
  }
</style>
