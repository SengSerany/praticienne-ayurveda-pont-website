---
import Eyebrow from '../ui/Eyebrow.astro';
import { surtitreDeSection } from '../../lib/manuel';

interface Props {
  numero?: string;
  surtitre: string;
  titre: string;
  // Place le media de marge en regard du texte, a droite par defaut.
  media?: 'droite' | 'gauche';
  // Compose le texte sur deux colonnes, a la largeur du media pose dessous.
  colonnes?: 1 | 2;
  // Decale le texte dans la moitie droite, sur la grille des deux colonnes.
  texte?: 'gauche' | 'droite';
  // Decale aussi le surtitre et le titre, par exception : d'ordinaire ils
  // gardent toute la largeur.
  tete?: 'gauche' | 'droite';
}
const {
  numero,
  surtitre,
  titre,
  media,
  colonnes = 1,
  texte = 'gauche',
  tete = 'gauche',
} = Astro.props;
const eyebrow = surtitreDeSection(surtitre, numero);
---

<section
  class:list={[
    'section-editoriale',
    media && 'section-editoriale--regard',
    media === 'gauche' && 'section-editoriale--regard-gauche',
    colonnes === 2 && 'section-editoriale--deux-colonnes',
    texte === 'droite' && 'section-editoriale--texte-droite',
    tete === 'droite' && 'section-editoriale--tete-droite',
  ]}
>
  <header class="section-editoriale__tete">
    <Eyebrow text={eyebrow} />
    <h2>{titre}</h2>
  </header>
  <div class="section-editoriale__corps">
    <slot />
  </div>
  {
    Astro.slots.has('marge') && (
      <div class="section-editoriale__marge">
        <slot name="marge" />
      </div>
    )
  }
</section>

<style>
  /* Marge et non padding : les marges de deux sections voisines se recouvrent
     au lieu de s'additionner, et absorbent celle du dernier paragraphe. En
     padding, une section etait plus aeree en bas qu'en haut, et deux sections
     qui se suivent doublaient leur espacement. Une marge unique remplace les
     deux paddings qui s'empilaient, d'ou le double du palier normal. */
  .section-editoriale {
    --gouttiere-texte: clamp(2.5rem, 4vw, 4rem);
    padding-inline: var(--marge-page);
    margin-block: calc(var(--espace-section) * 2);
  }
  /* Le media de marge se detache du texte : le double du rythme de paragraphe,
     la ou il n'heritait que de la marge basse du dernier paragraphe. L'exergue,
     qui porte deja sa propre respiration, garde la sienne. */
  .section-editoriale__marge {
    margin-block-start: calc(var(--rythme-para) * 2);
  }

  /* Texte sur deux colonnes : il coule de l'une a l'autre comme dans un livre,
     les hauteurs s'equilibrent seules. La largeur de la section remplace alors
     la mesure d'une colonne unique. Le conteneur multicolonne garde la marge de
     son dernier paragraphe, d'ou sa remise a zero : l'ecart jusqu'au media
     reste celui des autres sections. */
  @media (min-width: 64rem) {
    .section-editoriale--deux-colonnes .section-editoriale__corps {
      columns: 2;
      column-gap: var(--gouttiere-texte);
    }
    .section-editoriale--deux-colonnes .section-editoriale__corps > :global(*) {
      max-width: none;
    }
    .section-editoriale--deux-colonnes .section-editoriale__corps > :global(:last-child) {
      margin-block-end: 0;
    }
  }

  /* Texte decale a droite, sans media en regard : le texte prend la moitie
     droite, au depart exact de la seconde colonne du texte sur deux colonnes.
     Les sections d'une page tiennent sur une grille. Le titre reste a gauche,
     sauf exception ou il suit le texte sur la meme ligne de depart. */
  @media (min-width: 64rem) {
    .section-editoriale--texte-droite .section-editoriale__corps,
    .section-editoriale--tete-droite .section-editoriale__tete {
      margin-inline-start: calc(50% + var(--gouttiere-texte) / 2);
    }
  }

  /* Media en regard : le titre tient toute la largeur, puis le texte et le
     media se font face sous lui, comme la double page du Pont. Le texte garde
     sa mesure en priorite, le media prend le reste, jusqu'a sa propre taille
     et au plus 34rem : un schema compact ne laisse pas de vide entre lui et le
     texte quand il est a gauche. En dessous de 64rem, tout revient sur une
     seule colonne et le media repasse sous le texte. */
  @media (min-width: 64rem) {
    .section-editoriale--regard {
      --gouttiere: clamp(3rem, 6vw, 6rem);
      display: grid;
      grid-template-columns:
        minmax(min(var(--rythme-colonne), 100% - 20rem - var(--gouttiere)), var(--rythme-colonne))
        minmax(20rem, max-content);
      grid-template-areas:
        'tete tete'
        'corps marge';
      column-gap: var(--gouttiere);
      align-items: start;
    }
    .section-editoriale--regard-gauche {
      grid-template-columns:
        minmax(20rem, max-content)
        minmax(min(var(--rythme-colonne), 100% - 20rem - var(--gouttiere)), var(--rythme-colonne));
      grid-template-areas:
        'tete tete'
        'marge corps';
    }
    /* Le titre couvre les deux colonnes : sans confinement, la longueur de sa
       ligne elargissait la colonne du media au-dela du schema. */
    .section-editoriale--regard .section-editoriale__tete {
      grid-area: tete;
      contain: inline-size;
    }
    .section-editoriale--regard .section-editoriale__corps {
      grid-area: corps;
    }
    .section-editoriale--regard .section-editoriale__marge {
      grid-area: marge;
      max-inline-size: 34rem;
      margin-block-start: 0;
    }
  }
</style>
