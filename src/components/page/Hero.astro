---
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface CTA {
  label: string;
  href: string;
  variant?: 'filled' | 'outline';
}
interface Props {
  eyebrow?: string;
  titre: string;
  sousLignes?: string[];
  signature?: string;
  cta?: CTA;
  microcopy?: string;
  variante?: 'couverture' | 'papier';
}
const {
  eyebrow,
  titre,
  sousLignes = [],
  signature,
  cta,
  microcopy,
  variante = 'couverture',
} = Astro.props;
---

<section class:list={['hero', `hero--${variante}`]}>
  <div class="hero__corps">
    {eyebrow && <Eyebrow text={eyebrow} />}
    <h1>{titre}</h1>
    {sousLignes.map((ligne) => <p class="hero__sous-ligne" set:html={ligne} />)}
    {signature && <p class="hero__signature">{signature}</p>}
    {
      cta && (
        <p class="hero__cta">
          <Button href={cta.href} label={cta.label} variant={cta.variant ?? 'outline'} />
          {microcopy && <span class="hero__microcopy">{microcopy}</span>}
        </p>
      )
    }
    <div class="hero__texte"><slot /></div>
  </div>
  {
    Astro.slots.has('media') && (
      <div class="hero__media">
        <slot name="media" />
      </div>
    )
  }
</section>

<style>
  .hero {
    display: grid;
    gap: 2rem;
    padding: var(--espace-section-ample) var(--marge-page);
  }
  @media (min-width: 52rem) {
    .hero {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
    }
  }
  .hero--couverture {
    background-color: var(--c-couverture);
    padding-block: var(--espace-section);
    --c-label: var(--c-encre);
    color: var(--c-encre);
  }
  /* Sur papier, aucun bord ne ferme le hero : son rembourrage bas s'ajoutait a
     la marge de la section suivante et doublait l'ecart. La marge de section
     porte seule la respiration, comme entre deux sections. */
  .hero--papier {
    background-color: var(--c-papier);
    padding-block-end: 0;
  }
  .hero h1 {
    margin-bottom: 0.667em;
  }
  .hero__sous-ligne {
    max-width: 34rem;
    font-size: var(--t-lead-size);
    line-height: var(--t-lead-lh);
  }
  .hero__signature {
    font-family: var(--f-quote);
    font-style: italic;
    font-size: var(--t-quote-size);
    max-width: 34rem;
  }
  /* La marge doit depasser celle du paragraphe qui precede, sinon les deux se
     recouvrent et le reglage reste sans effet : la signature apporte deja 45 px
     a elle seule. */
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(2.75rem, 4.7vw, 4.25rem);
  }
  .hero__microcopy {
    font-family: var(--f-quote);
    font-style: italic;
    color: var(--c-label);
  }
  .hero__texte {
    max-width: 34rem;
  }
  .hero__texte:empty {
    display: none;
  }
  .hero__texte > :global(:last-child) {
    margin-block-end: 0;
  }
</style>
