---
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { svgEnLigne } from '../../lib/svg';

interface CTA {
  label: string;
  href: string;
  variant?: 'filled' | 'outline';
}
interface Props {
  eyebrow?: string;
  titre: string;
  sousLignes?: string[];
  signature?: string;
  cta?: CTA;
  microcopy?: string;
  variante?: 'couverture' | 'papier';
  // Par exception, le titre prend toute la largeur du hero au lieu de sa colonne.
  titrePleineLargeur?: boolean;
  // Planche SVG de public/ posee en fond, a droite du texte, par exemple '/planche-premier-echange.svg'.
  planche?: string;
}
const {
  eyebrow,
  titre,
  sousLignes = [],
  signature,
  cta,
  microcopy,
  variante = 'couverture',
  titrePleineLargeur = false,
  planche,
} = Astro.props;
const plancheEnLigne = planche ? svgEnLigne(planche) : undefined;
---

<section
  class:list={[
    'hero',
    `hero--${variante}`,
    titrePleineLargeur && 'hero--titre-pleine-largeur',
    plancheEnLigne && 'hero--planche',
  ]}
>
  {plancheEnLigne && <div class="hero__planche" set:html={plancheEnLigne} />}
  <div class="hero__corps">
    <div class="hero__tete">
      {eyebrow && <Eyebrow text={eyebrow} />}
      <h1>{titre}</h1>
    </div>
    <div class="hero__suite">
      {sousLignes.map((ligne) => <p class="hero__sous-ligne" set:html={ligne} />)}
      {signature && <p class="hero__signature">{signature}</p>}
      {
        cta && (
          <p class="hero__cta">
            <Button href={cta.href} label={cta.label} variant={cta.variant ?? 'outline'} />
            {microcopy && <span class="hero__microcopy">{microcopy}</span>}
          </p>
        )
      }
      <div class="hero__texte"><slot /></div>
    </div>
  </div>
  {
    Astro.slots.has('media') && (
      <div class="hero__media">
        <slot name="media" />
      </div>
    )
  }
</section>

<style>
  .hero {
    display: grid;
    gap: 2rem;
    padding: var(--espace-section-ample) var(--marge-page);
  }
  @media (min-width: 52rem) {
    .hero {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
    }
    /* Seuls le surtitre et le titre profitent de toute la largeur ; le texte
       garde sa colonne, avec le media a sa droite. Sans ecart de rangee et
       aligne en haut, le texte reste a sa distance habituelle du titre, celle
       de sa marge, et le media part de la meme ligne que lui. */
    .hero--titre-pleine-largeur {
      row-gap: 0;
      align-items: start;
    }
    .hero--titre-pleine-largeur .hero__corps {
      display: contents;
    }
    .hero--titre-pleine-largeur .hero__tete {
      grid-column: 1 / -1;
    }
  }
  .hero--couverture {
    background-color: var(--c-couverture);
    padding-block: var(--espace-section);
    --c-label: var(--c-encre);
    color: var(--c-encre);
  }
  /* Sur papier, aucun bord ne ferme le hero : son rembourrage bas s'ajoutait a
     la marge de la section suivante et doublait l'ecart. La marge de section
     porte seule la respiration, comme entre deux sections. */
  .hero--papier {
    background-color: var(--c-papier);
    padding-block-end: 0;
  }
  /* Grande planche au trait sous le texte, comme celle de Seuil. Sa boite part
     un peu avant la fin de la colonne de texte ; le dessin, ancre a droite,
     deborde du cadre et le hero coupe ce qui depasse. En mobile le texte prend
     toute la largeur, la planche s'efface. */
  .hero--planche {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .hero__planche {
    display: none;
    position: absolute;
    inset-block: 0;
    inset-inline: 46% 0;
    z-index: -1;
    color: var(--c-sauge);
    pointer-events: none;
  }
  .hero__planche :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (min-width: 52rem) {
    .hero__planche {
      display: block;
    }
  }
  .hero h1 {
    margin-bottom: 0.667em;
  }
  .hero__sous-ligne {
    max-width: 34rem;
    font-size: var(--t-lead-size);
    line-height: var(--t-lead-lh);
  }
  .hero__signature {
    font-family: var(--f-quote);
    font-style: italic;
    font-size: var(--t-quote-size);
    max-width: 34rem;
  }
  /* La marge doit depasser celle du paragraphe qui precede, sinon les deux se
     recouvrent et le reglage reste sans effet : la signature apporte deja 45 px
     a elle seule. */
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(2.75rem, 4.7vw, 4.25rem);
  }
  .hero__microcopy {
    font-family: var(--f-quote);
    font-style: italic;
    color: var(--c-label);
  }
  .hero__texte {
    max-width: 34rem;
  }
  .hero__texte:empty {
    display: none;
  }
  .hero__texte > :global(:last-child) {
    margin-block-end: 0;
  }
</style>
